# Copy this file to .env and adjust the values.
# Every application variable below maps to a field in internal/config/config.go.
# Durations use Go syntax, e.g. 30s, 5m, 1h.

#--- Application ---
#The application name. Also used as the JWT realm.
APPLICATION_NAME=golang_gin_boilerplate
#How long to wait for in-flight requests to finish on shutdown.
APPLICATION_SHUTDOWN_TIMEOUT=5m

#--- HTTP server ---
#The interface the server listens on. 0.0.0.0 is required inside Docker so the port is reachable from the host.
HOST=0.0.0.0
#The application port inside the Docker network.
PORT=7788
HTTP_SERVER_READ_HEADER_TIMEOUT=5m
HTTP_SERVER_READ_TIMEOUT=5m
HTTP_SERVER_WRITE_TIMEOUT=5m

#--- Auth (JWT) ---
#Required: the application refuses to start when this is empty.
#Generate a unique value, e.g. with: openssl rand -hex 32
AUTH_JWT_SECRET=
#How long an access token is valid.
AUTH_JWT_TOKEN_DURATION=1h
#How long a token can still be refreshed.
AUTH_JWT_REFRESH_TOKEN_DURATION=1h

#--- Database ---
DB_USER=local_user
DB_PASSWORD=password
DB_DRIVER=mysql
DB_NAME=gin_example_docker
DB_HOST=gin_db
DB_PORT=3306
#Connection pool settings.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFE=360s

#--- Logging ---
#Value of the "application" field in every log record.
LOG_APPLICATION=golang_gin_boilerplate
#Path to a log file. Logs go to stdout when empty.
LOG_FILE=
#One of: DEBUG, INFO, WARN, ERROR.
LOG_LEVEL=DEBUG
#Add the source code position to log records.
LOG_ADD_SOURCE=false

#--- Docker Compose (host side, not read by the application) ---
#The user's and group's identifiers used inside the development Docker container.
#Set them to the current host user's values: id -u and id -g
COMPOSE_USER_ID=
COMPOSE_GROUP_ID=
#The port for accessing the application from the host.
EXPOSE_PORT=7788
#The port for accessing the database from the host.
EXPOSE_DB_PORT=33061

# Test environment settings, kept in sync with internal/config/config.go.
# Note: no code loads this file at the moment; integration tests configure
# their containers in test/setup/application.go.

APPLICATION_NAME=golang_gin_boilerplate_test
APPLICATION_SHUTDOWN_TIMEOUT=30s

HOST=
PORT=7788
HTTP_SERVER_READ_HEADER_TIMEOUT=5m
HTTP_SERVER_READ_TIMEOUT=5m
HTTP_SERVER_WRITE_TIMEOUT=5m

AUTH_JWT_SECRET=test
AUTH_JWT_TOKEN_DURATION=100s
AUTH_JWT_REFRESH_TOKEN_DURATION=100s

DB_USER=root
DB_PASSWORD=db_password
DB_DRIVER=mysql
DB_NAME=test
DB_HOST=mysql
DB_PORT=3306

DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFE=360s

LOG_APPLICATION=golang_gin_boilerplate_test
LOG_FILE=
LOG_LEVEL=DEBUG
LOG_ADD_SOURCE=false
